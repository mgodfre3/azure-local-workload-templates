{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Azure Local workload answers (v1)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "deploymentName", "subscriptionId", "resourceGroup", "location", "stamp", "logicalNetworkId", "storageContainerId", "adminUsername", "passwordSource", "logAnalyticsWorkspaceId", "workloads"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "deploymentName": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,23}$" },
    "subscriptionId": { "type": "string", "pattern": "^[0-9a-fA-F]{8}-([0-9a-fA-F]{4}-){3}[0-9a-fA-F]{12}$" },
    "resourceGroup": { "type": "string", "pattern": "^(?!.*\\.$)[a-zA-Z0-9_().-]{1,90}$" },
    "location": { "type": "string", "pattern": "^[a-z][a-z0-9]+$" },
    "stamp": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clusterResourceId", "customLocationId", "mappingConfirmed"],
      "properties": {
        "clusterResourceId": { "$ref": "#/definitions/resourceId" },
        "customLocationId": { "$ref": "#/definitions/resourceId" },
        "mappingConfirmed": { "const": true, "description": "Operator verified this custom location belongs to this stamp." }
      }
    },
    "logicalNetworkId": { "$ref": "#/definitions/resourceId" },
    "storageContainerId": { "$ref": "#/definitions/resourceId" },
    "logAnalyticsWorkspaceId": { "$ref": "#/definitions/resourceId" },
    "adminUsername": { "type": "string", "minLength": 3, "maxLength": 20, "pattern": "^[a-z][a-z0-9_]*$" },
    "passwordSource": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["type"], "properties": { "type": { "const": "prompt" } }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["type", "name"],
          "properties": {
            "type": { "const": "environment" },
            "name": { "type": "string", "pattern": "^[A-Z_][A-Z0-9_]{0,63}$" }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["type", "vaultResourceId", "secretName", "secretVersion"],
          "properties": {
            "type": { "const": "keyVault" },
            "vaultResourceId": { "$ref": "#/definitions/resourceId" },
            "secretName": { "type": "string", "pattern": "^[a-zA-Z0-9-]{1,127}$" },
            "secretVersion": { "type": "string", "pattern": "^[0-9a-fA-F]{32}$" }
          }
        }
      ]
    },
    "workloads": {
      "type": "array", "minItems": 1, "maxItems": 20,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "profile", "processors", "memoryMB", "allowedCidrs", "image"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,13}[a-z0-9]$" },
          "profile": { "enum": ["fileServer", "sqlServer", "webServer", "iisServer", "windowsApp", "linuxApp"] },
          "count": { "type": "integer", "minimum": 0, "maximum": 20, "description": "Omit for a legacy single VM with the exact name. Explicit counts use name-01, name-02, etc., including count 1. Zero disables the entry." },
          "processors": { "type": "integer", "minimum": 2, "maximum": 64 },
          "memoryMB": { "type": "integer", "minimum": 2048, "maximum": 262144, "multipleOf": 1024 },
          "suggestedOsDiskSizeGB": { "type": "integer", "minimum": 32, "maximum": 2048, "description": "Capacity planning suggestion only; OS disks inherit the image size with the pinned stable API. Prepare an appropriately sized image separately." },
          "dataDiskSizeGB": { "type": "integer", "minimum": 32, "maximum": 8192 },
          "dataDisks": {
            "type": "array", "maxItems": 4,
            "items": {
              "type": "object", "additionalProperties": false, "required": ["role", "sizeGB"],
              "properties": {
                "role": { "type": "string", "pattern": "^[a-z][a-z0-9]{0,11}$" },
                "sizeGB": { "type": "integer", "minimum": 32, "maximum": 8192 }
              }
            },
            "description": "Base application profiles only. Role determines the stable disk suffix; disks remain unformatted."
          },
          "privateIpAddress": { "type": "string", "pattern": "^[0-9]{1,3}(\\.[0-9]{1,3}){3}$" },
          "privateIpAddresses": {
            "type": "array", "maxItems": 20, "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[0-9]{1,3}(\\.[0-9]{1,3}){3}$" },
            "description": "One explicit address per counted instance, in index order; omit on DHCP."
          },
          "allowedCidrs": {
            "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[0-9]{1,3}(\\.[0-9]{1,3}){3}/([89]|[12][0-9]|3[0-2])$" }
          },
          "sshPublicKey": { "type": "string", "maxLength": 4096, "pattern": "^ssh-rsa [A-Za-z0-9+/=]+( [^\\r\\n]+)?$" },
          "image": { "$ref": "#/definitions/image" },
          "fileServer": {
            "type": "object", "additionalProperties": false, "required": ["shareName"],
            "properties": { "shareName": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{1,31}$" } }
          },
          "sqlServer": {
            "type": "object", "additionalProperties": false,
            "required": ["installerUrl", "installerSha256", "edition", "acceptLicenseTerms"],
            "properties": {
              "installerUrl": { "type": "string", "pattern": "^https://[^\\s]+\\.iso$" },
              "installerSha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
              "edition": { "enum": ["Developer", "Evaluation"] },
              "acceptLicenseTerms": { "const": true }
            }
          }
        },
        "allOf": [
          {
            "if": { "properties": { "profile": { "const": "fileServer" } } },
            "then": {
              "required": ["dataDiskSizeGB", "fileServer"],
              "properties": { "memoryMB": { "minimum": 4096 }, "image": { "properties": { "os": { "const": "WindowsServer2022" } } } },
              "not": { "anyOf": [ { "required": ["sqlServer"] }, { "required": ["sshPublicKey"] }, { "required": ["dataDisks"] } ] }
            }
          },
          {
            "if": { "properties": { "profile": { "const": "sqlServer" } } },
            "then": {
              "required": ["dataDiskSizeGB", "sqlServer"],
              "properties": { "memoryMB": { "minimum": 8192 }, "image": { "properties": { "os": { "const": "WindowsServer2022" } } } },
              "not": { "anyOf": [ { "required": ["fileServer"] }, { "required": ["sshPublicKey"] }, { "required": ["dataDisks"] } ] }
            }
          },
          {
            "if": { "properties": { "profile": { "enum": ["webServer", "linuxApp"] } } },
            "then": {
              "required": ["sshPublicKey"],
              "properties": { "image": { "properties": { "source": { "enum": ["existing", "local", "blob"] }, "os": { "const": "Ubuntu2204" }, "preparedImageConfirmed": { "const": true } }, "required": ["preparedImageConfirmed"] } },
              "not": { "anyOf": [ { "required": ["dataDiskSizeGB"] }, { "required": ["fileServer"] }, { "required": ["sqlServer"] } ] }
            }
          },
          {
            "if": { "properties": { "profile": { "const": "webServer" } } },
            "then": { "not": { "required": ["dataDisks"] } }
          },
          {
            "if": { "properties": { "profile": { "enum": ["iisServer", "windowsApp"] } } },
            "then": {
              "properties": { "memoryMB": { "minimum": 4096 }, "image": { "properties": { "os": { "const": "WindowsServer2022" } } } },
              "not": { "anyOf": [ { "required": ["fileServer"] }, { "required": ["sqlServer"] }, { "required": ["sshPublicKey"] } ] }
            }
          },
          {
            "if": { "properties": { "profile": { "const": "iisServer" } } },
            "then": { "required": ["dataDiskSizeGB"], "not": { "required": ["dataDisks"] } }
          },
          {
            "if": { "properties": { "profile": { "const": "windowsApp" } } },
            "then": { "not": { "required": ["dataDiskSizeGB"] } }
          }
        ]
      }
    }
  },
  "definitions": {
    "resourceId": {
      "type": "string",
      "pattern": "^/[sS][uU][bB][sS][cC][rR][iI][pP][tT][iI][oO][nN][sS]/[0-9a-fA-F-]{36}/[rR][eE][sS][oO][uU][rR][cC][eE][gG][rR][oO][uU][pP][sS]/[a-zA-Z0-9_.()-]+/[pP][rR][oO][vV][iI][dD][eE][rR][sS]/[a-zA-Z.]+/[a-zA-Z]+/[a-zA-Z0-9_.-]+$"
    },
    "image": {
      "type": "object", "additionalProperties": false,
      "required": ["source", "os"],
      "properties": {
        "source": { "enum": ["existing", "marketplace", "local", "blob"] },
        "os": { "enum": ["WindowsServer2022", "Ubuntu2204"] },
        "resourceId": { "$ref": "#/definitions/resourceId" },
        "preparedImageConfirmed": { "type": "boolean" },
        "path": { "type": "string", "minLength": 10, "maxLength": 1024 },
        "stampPathConfirmed": { "const": true },
        "uri": { "type": "string", "maxLength": 2048 },
        "sasTokenEnvironmentVariable": { "type": "string", "pattern": "^[A-Z_][A-Z0-9_]{0,63}$" },
        "pageBlobConfirmed": { "const": true },
        "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$", "description": "Operator-verified prepared-image digest for immutable identity/reuse. The import API does not verify the digest." },
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,50}$" },
        "publisher": { "const": "microsoftwindowsserver" },
        "offer": { "const": "windowsserver" },
        "sku": { "const": "2022-datacenter-azure-edition" },
        "version": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+){2,3}$" },
        "licenseAndMarketplaceTermsConfirmed": { "const": true }
      },
      "allOf": [
        {
          "if": { "properties": { "source": { "const": "existing" } } },
          "then": { "required": ["resourceId"], "not": { "anyOf": [ { "required": ["name"] }, { "required": ["publisher"] }, { "required": ["offer"] }, { "required": ["sku"] }, { "required": ["version"] }, { "required": ["licenseAndMarketplaceTermsConfirmed"] }, { "required": ["path"] }, { "required": ["stampPathConfirmed"] }, { "required": ["uri"] }, { "required": ["sasTokenEnvironmentVariable"] }, { "required": ["pageBlobConfirmed"] }, { "required": ["sha256"] } ] } }
        },
        {
          "if": { "properties": { "source": { "const": "marketplace" } } },
          "then": {
            "required": ["name", "publisher", "offer", "sku", "version", "licenseAndMarketplaceTermsConfirmed"],
            "properties": { "os": { "const": "WindowsServer2022" } },
            "not": { "anyOf": [ { "required": ["resourceId"] }, { "required": ["preparedImageConfirmed"] }, { "required": ["path"] }, { "required": ["stampPathConfirmed"] }, { "required": ["uri"] }, { "required": ["sasTokenEnvironmentVariable"] }, { "required": ["pageBlobConfirmed"] }, { "required": ["sha256"] } ] }
          }
        },
        {
          "if": { "properties": { "source": { "enum": ["local", "blob"] } } },
          "then": {
            "required": ["name", "sha256", "preparedImageConfirmed"],
            "properties": { "os": { "const": "Ubuntu2204" }, "preparedImageConfirmed": { "const": true } },
            "not": { "anyOf": [ { "required": ["resourceId"] }, { "required": ["publisher"] }, { "required": ["offer"] }, { "required": ["sku"] }, { "required": ["version"] }, { "required": ["licenseAndMarketplaceTermsConfirmed"] } ] }
          }
        },
        {
          "if": { "properties": { "source": { "const": "local" } } },
          "then": {
            "required": ["path", "stampPathConfirmed"],
            "not": { "anyOf": [ { "required": ["uri"] }, { "required": ["sasTokenEnvironmentVariable"] }, { "required": ["pageBlobConfirmed"] } ] }
          }
        },
        {
          "if": { "properties": { "source": { "const": "blob" } } },
          "then": {
            "required": ["uri", "sasTokenEnvironmentVariable", "pageBlobConfirmed"],
            "not": { "anyOf": [ { "required": ["path"] }, { "required": ["stampPathConfirmed"] } ] }
          }
        }
      ]
    }
  }
}
